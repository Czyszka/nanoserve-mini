# Skopiuj do .env (ignorowany przez git) i uzupelnij sekrety.

# --- sekrety ---
HF_TOKEN=hf_xxx
# Klucz do LiteLLM; ten sam wpisujesz klientom jako ANTHROPIC_AUTH_TOKEN.
LITELLM_MASTER_KEY=sk-perliczka-zmien-mnie

# --- porty na hoscie ---
LITELLM_HOST_PORT=8100
MINIMAX_HOST_PORT=8102
DSV41_HOST_PORT=8104

# --- wyspy NVLink ---
DSV41_CUDA_VISIBLE_DEVICES=0,1,2,3
MINIMAX_CUDA_VISIBLE_DEVICES=4,5,6,7

# --- sciezki ---
MODELS_DIR=/SASRAID/models/vllm_models
DSV41_KV_CACHE_DIR=/home/ubuntusrv2/.vllm/kv_cache

# --- DeepSeek (limity pamieci; recepta ich nie ustawia -> CUDA OOM) ---
# Przy kolejnym OOM: najpierw nizej UTIL (0.80), potem MAX_MODEL_LEN / MAX_NUM_SEQS.
DSV41_GPU_MEM_UTIL=0.85
DSV41_MAX_MODEL_LEN=131072
DSV41_MAX_NUM_SEQS=64

# --- MiniMax ---
MINIMAX_MAX_MODEL_LEN=262144
MINIMAX_MAX_NUM_SEQS=80
# Uklad rownoleglosci. TP4 pada (192 vs 384); domyslnie DP4 + EP na wyspie 4-7.
# Ostatecznosc: "--tensor-parallel-size 8" + MINIMAX_CUDA_VISIBLE_DEVICES=0,...,7 (bez DeepSeeka).
MINIMAX_PARALLEL_ARGS=--data-parallel-size 4 --enable-expert-parallel

# --- Monitoring ---
# Odkomentuj, aby `docker compose up -d` zawsze startowal tez monitoring.
# COMPOSE_PROFILES=observability
GRAFANA_HOST_PORT=3101
PROMETHEUS_HOST_PORT=9190
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=zmien-mnie
PROMETHEUS_RETENTION=30d
PROMETHEUS_DATA_DIR=/home/ubuntusrv2/perliczka_proj/prometheus-data
GRAFANA_DATA_DIR=/home/ubuntusrv2/perliczka_proj/grafana-data
