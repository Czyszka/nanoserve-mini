# Skopiuj do .env (ignorowany przez git) i uzupelnij sekrety.

# --- sekrety ---
HF_TOKEN=hf_xxx
# Klucz do LiteLLM; ten sam wpisujesz klientom jako ANTHROPIC_AUTH_TOKEN.
LITELLM_MASTER_KEY=sk-perliczka-zmien-mnie

# --- porty na hoscie ---
LITELLM_HOST_PORT=8100
MINIMAX_HOST_PORT=8102
DSV41_HOST_PORT=8104

# --- wyspy NVLink ---
DSV41_CUDA_VISIBLE_DEVICES=0,1,2,3
MINIMAX_CUDA_VISIBLE_DEVICES=4,5,6,7

# --- sciezki ---
MODELS_DIR=/sasraid/models/vllm_models
DSV41_KV_CACHE_DIR=/home/ubuntusrv2/.vllm/kv_cache

# --- MiniMax ---
MINIMAX_MAX_MODEL_LEN=262144
MINIMAX_MAX_NUM_SEQS=80
# Liczba tokenow draftu DSpark (recepty: 3 albo 7).
MINIMAX_SPEC_TOKENS=3

# --- Monitoring ---
# Odkomentuj, aby `docker compose up -d` zawsze startowal tez monitoring.
# COMPOSE_PROFILES=observability
GRAFANA_HOST_PORT=3101
PROMETHEUS_HOST_PORT=9190
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=zmien-mnie
PROMETHEUS_RETENTION=30d
PROMETHEUS_DATA_DIR=/home/ubuntusrv2/working/perliczka-observability/prometheus-data
GRAFANA_DATA_DIR=/home/ubuntusrv2/working/perliczka-observability/grafana-data
