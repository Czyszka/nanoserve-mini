# Zmienne dla Claude Code na kliencie (wg integracji Claude Code z vLLM),
# kierowane przez LiteLLM Proxy stacku perliczka.
# Windows (na stale):  setx NAZWA "wartosc"   — potem nowe okno terminala.
# Linux/macOS:         export NAZWA="wartosc" (np. w ~/.bashrc).

ANTHROPIC_BASE_URL=http://<adres-serwera>:8100
# = LITELLM_MASTER_KEY z .env serwera (wysylany jako Bearer).
ANTHROPIC_AUTH_TOKEN=sk-perliczka-zmien-mnie

# Mapowanie klas modeli Claude Code -> modele w LiteLLM.
# Na razie wszystko na DeepSeek (dziala). Docelowo, gdy wstanie MiniMax:
#   OPUS=deepseek-v4.1-flash, SONNET/HAIKU/MODEL/SUBAGENT=minimax-m3.1-flash.
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4.1-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4.1-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4.1-flash
# Model domyslny sesji (bez /model).
ANTHROPIC_MODEL=deepseek-v4.1-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4.1-flash

# Okno kontekstu = --max-model-len serwera (128k). Bez tego Claude Code zaklada
# 200k dla nieznanych modeli i przepelnia kontekst przed auto-kompaktowaniem.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=131072
# Auto-kompaktowanie przy ~110k (zapas na odpowiedz modelu).
CLAUDE_CODE_AUTO_COMPACT_WINDOW=110000
CLAUDE_CODE_MAX_OUTPUT_TOKENS=16384

# Bez ruchu do uslug Anthropic.
DISABLE_AUTOUPDATER=1
DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
