# Zmienne dla Claude Code na kliencie (wg integracji Claude Code z vLLM),
# kierowane przez LiteLLM Proxy stacku perliczka.
# Windows (na stale):  setx NAZWA "wartosc"   — potem nowe okno terminala.
# Linux/macOS:         export NAZWA="wartosc" (np. w ~/.bashrc).

ANTHROPIC_BASE_URL=http://<adres-serwera>:8100
# = LITELLM_MASTER_KEY z .env serwera (wysylany jako Bearer).
ANTHROPIC_AUTH_TOKEN=sk-perliczka-zmien-mnie

# Mapowanie klas modeli Claude Code -> modele w LiteLLM.
# Na razie wszystko na MiniMax. Po uruchomieniu DeepSeeka: OPUS=deepseek-v4.1-flash.
ANTHROPIC_DEFAULT_OPUS_MODEL=minimax-m3.1-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=minimax-m3.1-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=minimax-m3.1-flash
# Model domyslny sesji (bez /model).
ANTHROPIC_MODEL=minimax-m3.1-flash
CLAUDE_CODE_SUBAGENT_MODEL=minimax-m3.1-flash

# Bez ruchu do uslug Anthropic.
DISABLE_AUTOUPDATER=1
DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
